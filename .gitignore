# ==========================================
# Global Wildcards (Targets Root and All Subfolders)
# ==========================================
**/__pycache__/
**/.vscode/
**/venv/
**/.venv/
**/env/
**/ENV/

# ==========================================
# Python Core & Bytecode
# ==========================================
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# ==========================================
# Editor & IDE Settings (PyCharm / Extras)
# ==========================================
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==========================================
# Environment Secrets & Credentials
# ==========================================
.env
.env.[a-zA-Z]*
!.env.example
secrets.json
*.pem
*.key

# ==========================================
# Distribution, Builds, and Packages
# ==========================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
